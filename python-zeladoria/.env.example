# ============================================
# CONFIGURAÇÕES DO SISTEMA DE ZELADORIA URBANA
# Belém do Pará
# ============================================

# ============================================
# BANCO DE DADOS
# ============================================

# SQLite (Desenvolvimento)
DATABASE_URL=sqlite:///./zeladoria.db

# PostgreSQL (Produção - Recomendado)
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/zeladoria

# MySQL (Alternativa)
# DATABASE_URL=mysql://usuario:senha@localhost:3306/zeladoria

# ============================================
# SEGURANÇA
# ============================================

# Chave secreta para JWT (ALTERE EM PRODUÇÃO!)
# Gere uma nova: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=sua-chave-secreta-muito-forte-e-aleatoria-aqui

# Algoritmo JWT
JWT_ALGORITHM=HS256

# Expiração do token (em minutos)
JWT_EXPIRATION=1440

# ============================================
# API
# ============================================

# URL base da API
API_URL=http://localhost:8001

# Título da API
API_TITLE=Sistema de Zeladoria Urbana - Belém/PA

# Versão da API
API_VERSION=2.0.0

# Descrição
API_DESCRIPTION=Sistema completo de gestão de zeladoria urbana

# ============================================
# AMBIENTE
# ============================================

# Ambiente: development, staging, production
ENVIRONMENT=development

# Debug mode (True/False)
DEBUG=True

# Modo de teste
TESTING=False

# ============================================
# CORS
# ============================================

# Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001,http://localhost:3000

# Permitir credenciais
ALLOW_CREDENTIALS=True

# Métodos permitidos
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH

# Headers permitidos
ALLOWED_HEADERS=*

# ============================================
# UPLOADS
# ============================================

# Diretório de uploads
UPLOAD_DIR=./uploads

# Tamanho máximo de arquivo (em bytes)
# 5MB = 5242880
# 10MB = 10485760
# 50MB = 52428800
MAX_UPLOAD_SIZE=5242880

# Extensões permitidas
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# ============================================
# EMAIL (SMTP)
# ============================================

# Habilitar envio de emails
EMAIL_ENABLED=False

# Servidor SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True

# Credenciais
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Remetente padrão
EMAIL_FROM=noreply@zeladoria-belem.gov.br
EMAIL_FROM_NAME=Sistema de Zeladoria - Belém/PA

# ============================================
# LOGS
# ============================================

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Arquivo de log
LOG_FILE=./logs/app.log

# Tamanho máximo do arquivo de log (em MB)
LOG_MAX_SIZE=10

# Número de backups de logs
LOG_BACKUP_COUNT=5

# Formato do log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================
# GEOLOCALIZAÇÃO
# ============================================

# Coordenadas padrão (Belém, PA)
DEFAULT_LATITUDE=-1.4558
DEFAULT_LONGITUDE=-48.4902

# Raio padrão de busca (em km)
DEFAULT_SEARCH_RADIUS=10

# ============================================
# NOTIFICAÇÕES
# ============================================

# Habilitar notificações push
PUSH_NOTIFICATIONS_ENABLED=False

# Chave de API de notificações push (Firebase, OneSignal, etc)
PUSH_API_KEY=

# ============================================
# RATE LIMITING
# ============================================

# Habilitar rate limiting
RATE_LIMIT_ENABLED=True

# Limite de requisições por minuto
RATE_LIMIT_PER_MINUTE=60

# Limite de requisições por hora
RATE_LIMIT_PER_HOUR=1000

# ============================================
# SLA (Service Level Agreement)
# ============================================

# SLA padrão para resolução (em horas)
SLA_DEFAULT_HOURS=24

# SLA por prioridade (em horas)
SLA_BAIXA=72
SLA_MEDIA=48
SLA_ALTA=24
SLA_CRITICA=12

# ============================================
# CACHE
# ============================================

# Habilitar cache
CACHE_ENABLED=True

# Tipo de cache: memory, redis
CACHE_TYPE=memory

# Redis (se CACHE_TYPE=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Tempo de expiração do cache (em segundos)
CACHE_TTL=300

# ============================================
# BACKUP
# ============================================

# Diretório de backups
BACKUP_DIR=./backups

# Retenção de backups (em dias)
BACKUP_RETENTION_DAYS=30

# Habilitar backup automático
AUTO_BACKUP_ENABLED=False

# Horário do backup automático (formato cron)
BACKUP_SCHEDULE=0 2 * * *

# ============================================
# INTEGRAÇÃO COM SISTEMAS EXTERNOS
# ============================================

# API de mapas (OpenStreetMap, Google Maps, etc)
MAPS_API_KEY=

# API de clima
WEATHER_API_KEY=

# Webhook para notificações
WEBHOOK_URL=

# ============================================
# DASHBOARD
# ============================================

# Atualização automática do dashboard (em segundos)
DASHBOARD_REFRESH_INTERVAL=30

# Período padrão de análises (em dias)
DASHBOARD_DEFAULT_PERIOD=30

# Número de itens em rankings
DASHBOARD_TOP_ITEMS=5

# ============================================
# PAGINAÇÃO
# ============================================

# Itens por página (padrão)
PAGE_SIZE=20

# Tamanho máximo de página
MAX_PAGE_SIZE=100

# ============================================
# TIMEZONE
# ============================================

# Fuso horário
TIMEZONE=America/Belem

# Formato de data
DATE_FORMAT=%d/%m/%Y

# Formato de data e hora
DATETIME_FORMAT=%d/%m/%Y %H:%M:%S

# ============================================
# FEATURES FLAGS
# ============================================

# Habilitar dashboard avançado
ADVANCED_DASHBOARD_ENABLED=True

# Habilitar comparação de períodos
PERIOD_COMPARISON_ENABLED=True

# Habilitar sistema de alertas
ALERTS_ENABLED=True

# Habilitar gráficos Chart.js
CHARTJS_ENABLED=True

# Habilitar exportação avançada
ADVANCED_EXPORT_ENABLED=True

# Habilitar mapa interativo
INTERACTIVE_MAP_ENABLED=True

# Habilitar geolocalização
GEOLOCATION_ENABLED=True

# Habilitar avaliações
RATINGS_ENABLED=True

# Habilitar comentários
COMMENTS_ENABLED=True

# Habilitar anexos
ATTACHMENTS_ENABLED=True

# ============================================
# MANUTENÇÃO
# ============================================

# Modo de manutenção
MAINTENANCE_MODE=False

# Mensagem de manutenção
MAINTENANCE_MESSAGE=Sistema em manutenção. Voltaremos em breve.

# ============================================
# DESENVOLVIMENTO
# ============================================

# Habilitar hot reload
HOT_RELOAD=True

# Habilitar profiler
PROFILER_ENABLED=False

# Habilitar SQL echo (mostrar queries)
SQL_ECHO=False

# ============================================
# MONITORAMENTO
# ============================================

# Habilitar Sentry (rastreamento de erros)
SENTRY_ENABLED=False
SENTRY_DSN=

# Habilitar Google Analytics
GOOGLE_ANALYTICS_ENABLED=False
GOOGLE_ANALYTICS_ID=

# ============================================
# REDES SOCIAIS (Compartilhamento)
# ============================================

# Facebook App ID
FACEBOOK_APP_ID=

# Twitter Handle
TWITTER_HANDLE=@zeladoriabelem

# ============================================
# MOBILE APP
# ============================================

# URL da Play Store
PLAY_STORE_URL=

# URL da App Store
APP_STORE_URL=

# ============================================
# CONTATO E SUPORTE
# ============================================

# Email de suporte
SUPPORT_EMAIL=suporte@zeladoria-belem.gov.br

# Telefone de suporte
SUPPORT_PHONE=(91) 3333-4444

# Horário de atendimento
SUPPORT_HOURS=Segunda a Sexta, 8h às 18h

# ============================================
# INFORMAÇÕES DO MUNICÍPIO
# ============================================

# Nome do município
MUNICIPALITY_NAME=Belém

# Estado
STATE=PA

# Nome completo
FULL_NAME=Prefeitura Municipal de Belém

# Site oficial
OFFICIAL_WEBSITE=https://belem.pa.gov.br

# Logo URL
LOGO_URL=/static/logo.png

# ============================================
# NOTAS
# ============================================

# 1. NUNCA commite o arquivo .env no Git!
# 2. Use .env.example como template
# 3. Gere uma nova SECRET_KEY em produção
# 4. Configure ALLOWED_ORIGINS em produção
# 5. Use PostgreSQL em produção (não SQLite)
# 6. Habilite HTTPS em produção
# 7. Configure backups automáticos
# 8. Monitore logs regularmente
# 9. Atualize as dependências periodicamente
# 10. Siga as melhores práticas de segurança
